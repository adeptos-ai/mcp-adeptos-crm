# Keep docker build context small and production-safe
node_modules
dist
.git
.github
.env
.env.*
!.env.example

# Local-only / docs not needed to build the image
*.md
!README.md
coverage
*.log
.vscode
.idea
.DS_Store

# Tests and local scripts (runtime image only needs compiled dist)
src/**/*.test.ts
src/**/__tests__
src/scripts
vitest.config.ts

# Alternate lockfiles (Dockerfile uses npm + package-lock.json)
pnpm-lock.yaml
pnpm-workspace.yaml
.npmrc

# Accidental scrap files
reading
resolve
transferring
CACHED
ERROR
[builder
[internal]
[--include
[--omit
