# Configuración del MCP Server
PORT=3005
NODE_ENV=development

# Conexión al Backend de Adeptos (API Go)
# Usa http://localhost:4000 si corres local sin docker
# Usa http://host.docker.internal:4000 si este MCP corre en Docker y tu back localmente
# Usa https://api.adeptos.ai para producción
ADEPTOS_API_BASE_URL=http://host.docker.internal:4000

# Opcional: Valores por defecto si el Agente IA no envía los headers correspondientes
# ADEPTOS_JWT_TOKEN=tu_jwt_aqui
# ADEPTOS_BUSINESS_ID=1
