# Configuración del MCP Server
PORT=3005
NODE_ENV=production

# Backend Adeptos
# VPS / producción:
ADEPTOS_API_BASE_URL=https://api.adeptos.ai
# Docker local (API en contenedor adeptosApi):
# ADEPTOS_API_BASE_URL=http://adeptosApi:4000
# MCP fuera de Docker:
# ADEPTOS_API_BASE_URL=http://127.0.0.1:4000

# Red Docker (debe existir como external)
# VPS:
MCP_DOCKER_NETWORK=fr-hotel-network
# Local con stack api:
# MCP_DOCKER_NETWORK=api_adeptos-network

# Opcional (el agente suele mandar headers; estos son fallback)
# ADEPTOS_JWT_TOKEN=
# ADEPTOS_BUSINESS_ID=
